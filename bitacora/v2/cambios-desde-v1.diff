+  })
+})
+
+describe('useTasks · tiempo real', () => {
+  it('aplica INSERT, UPDATE y DELETE de otros usuarios y avisa del último', async () => {
+    const a = makeTask()
+    const { hook, emit } = setup([a])
+    await waitFor(() => expect(hook.result.current.loading).toBe(false))
+
