# Copia este archivo como .env y llena los valores de tu proyecto de Supabase.
# .env NO se sube al repositorio (está en .gitignore).
# Solo la anon (publishable) key: la service_role nunca va en el frontend ni lleva el prefijo VITE_.
# Sin estas dos variables la app arranca en «modo demo» con datos simulados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
